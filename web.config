<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sachkhand Digital Marketing - IIS configuration.

  The host is GoDaddy Windows hosting (Microsoft-IIS/10.0 + Plesk), so
  .htaccess is ignored entirely; this file is the one the server reads.

  Compression is already handled by Plesk (responses come back with
  content-encoding: br), so nothing here configures it.

  If the site returns HTTP 500 after uploading this file, the IIS URL Rewrite
  module is not installed. Delete this file to restore the site immediately,
  then re-add it with the <rewrite> section removed - the headers and caching
  below do not depend on that module.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Canonical host: every canonical tag on the site points at
             https://www.sachkhanddigitalmarketing.com, so make the server
             agree. Without this, non-www serves a duplicate of every page. -->
        <rule name="Redirect to www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^sachkhanddigitalmarketing\.com$" />
          </conditions>
          <action type="Redirect"
                  url="https://www.sachkhanddigitalmarketing.com/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- One canonical homepage URL: /index.html -> / -->
        <rule name="Strip index.html" stopProcessing="true">
          <match url="^(.*/)?index\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- MIME types IIS does not ship with by default. Without the webp entry
         the blog hero images can be served with the wrong content type. -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>

  <!-- Caching. Media and fonts are versioned by filename (hero-720.webp) so
       they cache hard. CSS and JS are edited in place under the same name, so
       they must revalidate or returning visitors get a stale analytics.js. -->
  <location path="assets/img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="assets/css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="assets/js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
